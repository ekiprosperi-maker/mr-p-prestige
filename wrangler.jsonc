{ 
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mr-p-prestige",
  "main": "src/index.js",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mr-p-prestige-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "mr-p-prestige-images"
    }
  ]
}
